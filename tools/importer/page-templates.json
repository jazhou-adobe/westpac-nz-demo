        "https://www.westpac.co.nz/personal-loans/",
        "https://www.westpac.co.nz/personal-loans/car-loans/"
      ],
      "representativeUrl": "https://www.westpac.co.nz/accounts-cards/",
      "description": "To be named in naming step",
      "blocks": [],
